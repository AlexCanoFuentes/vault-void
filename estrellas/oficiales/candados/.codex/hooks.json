{
  "description": "La misma guardia que Claude Code (guardia.py). Codex pide revisarla y aprobarla en /hooks la primera vez.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/guardia.py\"",
            "timeout": 30,
            "statusMessage": "Guardia"
          }
        ]
      }
    ]
  }
}
