*.[rR][aA][rR]
*.7[zZ]

# La carpeta donde copias algo para que el agente lo mire una vez. Nunca entra en git:
# cuando termines, bórralo de ahí (el original sigue donde estaba).
mirar/

# Lo que genera Python al correr los programas
__pycache__/
*.pyc

# Permisos personales de Claude en esta máquina (no viajan con el repo)
.claude/settings.local.json

# La llave de tu vault en la red de Void (si te das de alta): es tuya y no sale de este equipo
.void/

# Por si alguna vez aparece un archivo de claves: nunca entra al repo
.env
.env.*
*.pem
