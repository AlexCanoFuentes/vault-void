# Este vault guarda TEXTO: tu trabajo, tus proyectos y tu criterio, con tus palabras.
# Tus correos, tus documentos, tus fotos y tus vídeos se quedan donde ya están (tu correo, tu
# nube, tu disco): el agente los consulta cuando se lo pides, y aquí solo se apunta lo que
# sacaste de ellos, o su ruta o su enlace, no la copia.
#
# Cada extensión va en mayúsculas y minúsculas porque Windows y los móviles guardan
# muchos archivos como FOTO.JPG o CONTRATO.PDF.
# Lo comprueba: python3 herramientas/revisar.py

# Documentos
*.[pP][dD][fF]
*.[dD][oO][cC]
*.[dD][oO][cC][xX]
*.[xX][lL][sS]
*.[xX][lL][sS][xX]
*.[pP][pP][tT]
*.[pP][pP][tT][xX]
*.[oO][dD][tT]
*.[oO][dD][sS]
*.[oO][dD][pP]
*.[pP][aA][gG][eE][sS]
*.[nN][uU][mM][bB][eE][rR][sS]
*.[kK][eE][yY]

# Correos guardados
*.[eE][mM][lL]
*.[mM][sS][gG]
*.[mM][bB][oO][xX]

# Imágenes
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
